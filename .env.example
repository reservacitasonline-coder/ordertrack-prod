# Supabase — obtener en https://app.supabase.com/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# Sentry — obtener en https://sentry.io/settings/conectaya-digital/projects/ordertrack/keys/
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>
# Solo para subir source maps en CI/CD (opcional en desarrollo local)
SENTRY_AUTH_TOKEN=<auth-token>
